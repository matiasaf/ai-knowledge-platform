# Copy to services/api/.env and adjust as needed. All values are optional.

# Where uploaded documents and their JSON sidecars are written.
# Relative paths are resolved against services/api, never against the shell's
# current working directory.
AKP_DATA_DIR=data

# Maximum accepted upload size in bytes (10 MiB).
AKP_MAX_UPLOAD_BYTES=10485760

# Maximum number of pages processed in one extraction request.
AKP_MAX_PDF_PAGES=250

# Maximum characters in one page-bounded retrieval chunk.
AKP_CHUNK_SIZE_CHARS=1000

# Character overlap between adjacent chunks from the same page.
AKP_CHUNK_OVERLAP_CHARS=150

# Optional generation configuration. The API starts without these values, but
# POST /answers returns generation_not_configured until both are set.
AKP_OPENAI_API_KEY=
AKP_OPENAI_MODEL=

# Server-controlled grounded-answer limits.
AKP_ANSWER_EVIDENCE_LIMIT=5
AKP_ANSWER_MAX_OUTPUT_TOKENS=800
AKP_ANSWER_TIMEOUT_SECONDS=30

# Comma-separated list of browser origins allowed to call this API.
AKP_CORS_ALLOW_ORIGINS=http://localhost:3000
